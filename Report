  <row>
    <panel id="panel_1">
      <single>
        <title>Captured Unused Resources</title>
        <search base="base">
          <query>
          | search accountid IN($accountid$)
          | search region IN($region$)
          | search resource_type IN($resource_type$)
          | search resource_name IN($resource_name$)
          | search resource_id IN($resource_id$)
          | search policy_name IN($policy_name$)
          | search excluded_resource IN($excluded_resource$)
| search remediated="No"
| stats dc(resource_id) as count

</query>
        </search>
        <!-- Adjust height here -->
        <option name="drilldown">none</option>
        <option name="height">50</option>
        <option name="rangeColors">["0xdc4e41","0xdc4e41"]</option>
        <option name="rangeValues">[0]</option>
        <option name="refresh.display">progressbar</option>
        <option name="trellis.enabled">0</option>
        <option name="trellis.size">large</option>
        <option name="trellis.splitBy">_aggregation</option>
        <option name="useColors">1</option>
      </single>
    </panel>
    <panel id="panel_2">
      <single>
        <title>Remediated Unused Resources</title>
        <search base="base">
          <query>
          | search accountid IN($accountid$)
          | search region IN($region$)
          | search resource_type IN($resource_type$)
          | search resource_name IN($resource_name$)
          | search resource_id IN($resource_id$)
          | search policy_name IN($policy_name$)
          | search excluded_resource IN($excluded_resource$)
| search remediated="Yes"
| stats dc(resource_id) as count

</query>
        </search>
        <option name="colorMode">none</option>
        <option name="drilldown">none</option>
        <option name="height">50</option>
        <option name="rangeColors">["0x118832","0x118832"]</option>
        <option name="rangeValues">[0]</option>
        <option name="refresh.display">progressbar</option>
        <option name="useColors">1</option>
      </single>
    </panel>
    <panel id="panel_3">
      <single>
        <title>Remediate Percent</title>
        <search base="base">
          <query>| search accountid IN($accountid$)
          | search region IN($region$)
          | search resource_type IN($resource_type$)
          | search resource_name IN($resource_name$)
          | search resource_id IN($resource_id$)
          | search policy_name IN($policy_name$)
          | search excluded_resource IN($excluded_resource$)
| stats count(eval(remediated="No")) as captured_count count(eval(remediated="Yes")) as remidediated_count count as total
| eval perCompliance=round(remidediated_count/total*100,2)
| appendpipe [| makeresults | eval perCompliance=0 ]
| stats sum(perCompliance) as sumPerCompliance</query>
        </search>
        <option name="drilldown">none</option>
        <option name="height">50</option>
        <option name="numberPrecision">0</option>
        <option name="rangeColors">["0x53a051","0x0877a6","0xf8be34","0xf1813f","0xdc4e41"]</option>
        <option name="refresh.display">progressbar</option>
        <option name="unit">%</option>
        <option name="unitPosition">after</option>
      </single>
    </panel>
  </row>
  <row>
