  <search id="base">
    <query>
index=max_database source=AwsAPI sourcetype="dynamodb-FlexeraUnusedResources_*" Table="FlexeraUnusedResources_Findings"
| rename *.S as *, *.N as *, *.BOOL as *
| rename meta_policy_name as policy_name tags as resource_tags incident_state as compliance_status
| rex field=child_policy_name "^[^:]+:\s*(?&lt;cp_account_name&gt;.+?)\s*\((?&lt;cp_account_id&gt;[^()]+)\)\s*\(child policy\)\s*$"
| eval accountid=coalesce(account_id, subscription_id, subscriptionId, project_id, projectId, cp_account_id)
| eval account_name=coalesce(account_name, subscription_name, subscriptionName, project_name, projectName, cp_account_name, accountid)
| eval region=coalesce(region, location, "global")
| eval resource_id=coalesce(resource_id, resourceARN, id)
| eval resource_name=coalesce(resource_name, hostname, if(match(resource_id,"(?i)^/subscriptions/"), replace(resource_id,"^.*/",""), null()))
| eval resource_id=case(
    match(resource_id,"(?i)^/subscriptions/"), resource_id,
    match(resource_id,"^arn:"), resource_id,
    isnotnull(resourceARN) AND match(resourceARN,"^arn:"), resourceARN,
    match(resource_id,"^snap-"), "arn:aws:ec2:".region.":".accountid.":snapshot/".resource_id,
    match(resource_id,"^vol-"), "arn:aws:ec2:".region.":".accountid.":volume/".resource_id,
    match(resource_id,"^i-"), "arn:aws:ec2:".region.":".accountid.":instance/".resource_id,
    match(resource_id,"^eipalloc-"), "arn:aws:ec2:".region.":".accountid.":elastic-ip/".resource_id,
    match(resource_id,"^ami-"), "arn:aws:ec2:".region."::image/".resource_id,
    match(resource_id,"^nat-"), "arn:aws:ec2:".region.":".accountid.":natgateway/".resource_id,
    match(resource_id,"^eni-"), "arn:aws:ec2:".region.":".accountid.":network-interface/".resource_id,
    match(policy_name,"(?i)rds") AND match(policy_name,"(?i)snapshot"), "arn:aws:rds:".region.":".accountid.":snapshot:".resource_id,
    match(policy_name,"(?i)rds"), "arn:aws:rds:".region.":".accountid.":db:".resource_id,
    match(policy_name,"(?i)redshift") AND match(policy_name,"(?i)snapshot"), "arn:aws:redshift:".region.":".accountid.":snapshot:".resource_id,
    match(policy_name,"(?i)redshift"), "arn:aws:redshift:".region.":".accountid.":cluster:".resource_id,
    match(policy_name,"(?i)s3|bucket"), "arn:aws:s3:::".resource_id,
    match(policy_name,"(?i)dynamodb"), "arn:aws:dynamodb:".region.":".accountid.":table/".resource_id,
    match(policy_name,"(?i)cloudwatch|log"), "arn:aws:logs:".region.":".accountid.":log-group:".resource_id,
    true(), resource_id)
| eval resource_type=case(
    match(resource_id,"(?i)/virtualMachines/"), "Azure VM",
    match(resource_id,"(?i)/databases/"), "Azure SQL Database",
    match(resource_id,"(?i)/publicIPAddresses/"), "Azure Public IP",
    match(resource_id,"(?i)/loadBalancers/"), "Azure Load Balancer",
    match(resource_id,"(?i)/disks/"), "Azure Managed Disk",
    match(resource_id,"(?i)/snapshots/"), "Azure Snapshot",
    match(resource_id,"(?i)/storageAccounts/"), "Azure Storage Account",
    match(resource_id,"(?i)/networkInterfaces/"), "Azure Network Interface",
    match(child_policy_name,"(?i)^Azure.*Compute"), "Azure VM",
    match(child_policy_name,"(?i)^Azure.*SQL"), "Azure SQL Database",
    match(child_policy_name,"(?i)^Azure.*IP"), "Azure Public IP",
    match(child_policy_name,"(?i)^Azure.*Load"), "Azure Load Balancer",
    match(child_policy_name,"(?i)^Azure.*Disk"), "Azure Managed Disk",
    match(child_policy_name,"(?i)^Azure.*Snapshot"), "Azure Snapshot",
    match(child_policy_name,"(?i)^Azure.*Storage"), "Azure Storage Account",
    match(child_policy_name,"(?i)^Azure"), "Azure ".coalesce(resourceType, service, "Resource"),
    match(resource_id,"^arn:aws:lambda:"), "Lambda Function",
    match(resource_id,":snapshot/snap-"), "EBS Snapshot",
    match(resource_id,":volume/vol-"), "EBS Volume",
    match(resource_id,":instance/i-"), "EC2 Instance",
    match(resource_id,":elastic-ip/"), "Elastic IP",
    match(resource_id,"::image/ami-"), "AMI",
    match(resource_id,":natgateway/"), "NAT Gateway",
    match(resource_id,":network-interface/"), "Network Interface",
    match(resource_id,"^arn:aws:rds:.*:snapshot:"), "RDS Snapshot",
    match(resource_id,"^arn:aws:rds:.*:cluster:"), "RDS Cluster",
    match(resource_id,"^arn:aws:rds:"), "RDS Instance",
    match(resource_id,"^arn:aws:redshift:.*:snapshot:"), "Redshift Snapshot",
    match(resource_id,"^arn:aws:redshift:"), "Redshift Cluster",
    match(resource_id,"^arn:aws:s3:"), "S3 Bucket",
    match(resource_id,"^arn:aws:dynamodb:"), "DynamoDB Table",
    match(resource_id,"^arn:aws:logs:"), "CloudWatch Log Group",
    match(resource_id,"^arn:aws:elasticloadbalancing:"), "Load Balancer",
    match(resource_id,"^arn:aws:ecs:"), "ECS",
    match(resource_id,"^arn:aws:eks:"), "EKS Cluster",
    match(resource_id,"^arn:aws:elasticache:"), "ElastiCache",
    match(resource_id,"^arn:aws:kinesis:"), "Kinesis Stream",
    match(resource_id,"^arn:aws:sagemaker:"), "SageMaker",
    match(resource_id,"^arn:aws:fsx:"), "FSx",
    match(resource_id,"^arn:aws:efs:"), "EFS",
    match(resource_id,"^arn:aws:backup:"), "Backup",
    match(policy_name,"(?i)lambda"), "Lambda Function",
    match(policy_name,"(?i)snapshot"), "EBS Snapshot",
    match(policy_name,"(?i)volume"), "EBS Volume",
    match(policy_name,"(?i)ec2|instance"), "EC2 Instance",
    match(policy_name,"(?i)ip|address"), "Elastic IP",
    match(policy_name,"(?i)image|ami"), "AMI",
    true(), coalesce(service, resourceType, "Other"))
| eval capture_date=strftime(strptime(incident_created_at,"%Y-%m-%dT%H:%M:%SZ"),"%m-%d-%Y")
| eval timestamp=strftime(strptime(incident_updated_at,"%Y-%m-%dT%H:%M:%SZ"),"%m-%d-%Y %H:%M:%S")
| eval compliance_status=case(compliance_status=="resolved","COMPLIANT", compliance_status=="triggered","NON_COMPLIANT", true(), compliance_status)
| eval status=compliance_status
| eval resource_created_date=if(isnotnull(launchTime), strftime(strptime(launchTime,"%Y-%m-%dT%H:%M:%S.%3NZ"),"%m-%d-%Y"), if(isnotnull(age), strftime(now()-tonumber(age)*86400,"%m-%d-%Y"), "N/A"))
| eval resource_details=trim(if(isnotnull(codeSize),"codeSize=".codeSize." ","").if(isnotnull(memorySize),"memorySize=".memorySize." ","").if(isnotnull(runtime),"runtime=".runtime." ","").if(isnotnull(invocations),"invocations=".invocations." ","").if(isnotnull(size),"size=".size." ","").if(isnotnull(iops),"iops=".iops,""))
| eval action_result="Success", action_type="Capture", auto_remediation="Captured", resource_created_by="N/A", resource_status="Available", retention_date="Not Available"
| eval payer_from_policy=if(match(policy_name,"^FlexeraUnusedResources-[^-]+-"), replace(policy_name,"^FlexeraUnusedResources-([^-]+)-.*","\1"), null())
| eval payer=coalesce(rbd_bill_source_friendly_name, payer_from_policy, "Unmapped")
| eval cloud_vendor=case(
    match(child_policy_name,"(?i)^\s*AWS\b"), "AWS",
    match(child_policy_name,"(?i)^\s*Azure\b"), "Azure",
    match(child_policy_name,"(?i)^\s*(GCP|Google)\b"), "GCP",
    match(policy_name,"(?i)AWS"), "AWS",
    match(policy_name,"(?i)Azure"), "Azure",
    match(policy_name,"(?i)GCP|Google"), "GCP",
    true(), "Other")
| eval accountalias=account_name
| eval Account=account_name."_".accountid
| eval cost=round(tonumber(coalesce(savings_usd,"0")),2)
| fillnull value="null"
| fillnull value="null" excluded_resource
| dedup accountid region resource_id policy_name keepempty=true
| rename retention_date as schedule
| eval remediation=if(auto_remediation="ON","AutoRemediation","ManualRemediation")
| eval countdown = if(remediation="ManualRemediation",0, round((strptime(schedule, "%m-%d-%Y") - now())/60/60/24, 0))
| eval remediated="No"
| eval resource_name=if(resource_name="null","default",resource_name)
| eval accountid=case(len(accountid)=10,"00".accountid,len(accountid)=11,"0".accountid,1=1,accountid)
| eval excluded_resource=if(excluded_resource="null","No",excluded_resource)
| eval flag=case(remediated="No" AND action_type="Capture","No", remediated="Yes" AND action_type!="Capture","Yes",1=1,"null")
| table accountid accountalias Account payer cloud_vendor region resource_type resource_id resource_name child_policy_name action_type action_result excluded_resource capture_date remediation auto_remediation countdown policy_name remediated resource_created_date resource_created_by resource_status resource_details resource_tags compliance_status status timestamp cost flag
    </query>
    <earliest>-24h</earliest>
    <latest>now</latest>
  </search>
