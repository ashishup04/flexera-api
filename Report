<form version="1.1">
  <label>Flexera Unused Resources - Consolidated</label>
  <search id="base">
    <query>
index=max_database source=AwsAPI sourcetype="dynamodb-FlexeraUnusedResources_*" Table="FlexeraUnusedResources_Findings"
| rename *.S as *, *.N as *, *.BOOL as *
| rename account_id as accountid meta_policy_name as policy_name tags as resource_tags incident_state as compliance_status
| eval resource_id=if(isnull(resource_name) OR resource_name="", resource_id, resource_name)
| eval resource_type=policy_name
| eval capture_date=strftime(strptime(incident_created_at,"%Y-%m-%dT%H:%M:%SZ"),"%m-%d-%Y")
| eval timestamp=strftime(strptime(incident_updated_at,"%Y-%m-%dT%H:%M:%SZ"),"%m-%d-%Y %H:%M:%S")
| eval compliance_status=case(compliance_status=="resolved","COMPLIANT", compliance_status=="triggered","NON_COMPLIANT", true(), compliance_status)
| eval status=compliance_status
| eval resource_created_date=if(isnotnull(launchTime), strftime(strptime(launchTime,"%Y-%m-%dT%H:%M:%S.%3NZ"),"%m-%d-%Y"), if(isnotnull(age), strftime(now()-tonumber(age)*86400,"%m-%d-%Y"), "N/A"))
| eval resource_details=trim(if(isnotnull(codeSize),"codeSize=".codeSize." ","").if(isnotnull(memorySize),"memorySize=".memorySize." ","").if(isnotnull(runtime),"runtime=".runtime." ","").if(isnotnull(invocations),"invocations=".invocations." ","").if(isnotnull(size),"size=".size." ","").if(isnotnull(iops),"iops=".iops,""))
| eval action_result="Success", action_type="Capture", auto_remediation="Captured", resource_created_by="N/A", resource_status="Available", retention_date="Not Available"
| eval accountalias=account_name
| eval Account=account_name."_".accountid
| eval cost=round(tonumber(coalesce(savings_usd,"0")),2)
| fillnull value="null"
| fillnull value="null" excluded_resource
| dedup accountid region resource_id policy_name
| rename retention_date as schedule
| eval remediation=if(auto_remediation="ON","AutoRemediation","ManualRemediation")
| eval countdown = if(remediation="ManualRemediation",0, round((strptime(schedule, "%m-%d-%Y") - now())/60/60/24, 0))
| eval remediated="No"
| eval resource_name=if(resource_name="null","default",resource_name)
| eval accountid=case(len(accountid)=10,"00".accountid,len(accountid)=11,"0".accountid,1=1,accountid)
| eval excluded_resource=if(excluded_resource="null","No",excluded_resource)
| eval flag=case(remediated="No" AND action_type="Capture","No", remediated="Yes" AND action_type!="Capture","Yes",1=1,"null")
| table accountid accountalias Account region resource_type resource_id resource_name action_type action_result excluded_resource capture_date remediation auto_remediation countdown policy_name remediated resource_created_date resource_created_by resource_status resource_details resource_tags compliance_status status timestamp cost flag
    </query>
    <earliest>-24h</earliest>
    <latest>now</latest>
  </search>
  <fieldset submitButton="false" autoRun="true">
    <input type="dropdown" token="remediated" searchWhenChanged="true">
      <label>Remediated</label>
      <fieldForLabel>remediated</fieldForLabel>
      <fieldForValue>remediated</fieldForValue>
      <choice value="*">All</choice>
      <choice value="Yes">Yes</choice>
      <choice value="No">No</choice>
      <default>No</default>
      <initialValue>No</initialValue>
    </input>
    <input type="multiselect" token="accountid" searchWhenChanged="true">
      <label>Account</label>
      <fieldForLabel>Account</fieldForLabel>
      <fieldForValue>accountid</fieldForValue>
      <choice value="*">All</choice>
      <search base="base">
        <query>
| dedup accountid
| table accountid Account
| sort Account
        </query>
      </search>
      <default>*</default>
      <delimiter>,</delimiter>
      <change>
        <eval token="form.accountid">if(mvcount('form.accountid')=0,"*",if(mvcount('form.accountid')!=1,mvfilter('form.accountid'!="*"),'form.accountid'))</eval>
      </change>
    </input>
    <input type="multiselect" token="region" searchWhenChanged="true" id="multiselect_input_owner">
      <label>Region</label>
      <fieldForLabel>region</fieldForLabel>
      <fieldForValue>region</fieldForValue>
      <choice value="*">All</choice>
      <default>*</default>
      <search base="base">
        <query>
          | dedup region
          | sort region
        </query>
      </search>
      <delimiter>,</delimiter>
      <change>
        <eval token="form.region">if(mvcount('form.region')=0,"*",if(mvcount('form.region')!=1,mvfilter('form.region'!="*"),'form.region'))</eval>
      </change>
    </input>
    <input type="multiselect" token="resource_type" searchWhenChanged="true" id="multiselect_input_insight">
      <label>Resource Type</label>
      <fieldForLabel>resource_type</fieldForLabel>
      <fieldForValue>resource_type</fieldForValue>
      <choice value="*">All</choice>
      <search base="base">
        <query>
        | search accountid IN($accountid$)
        | search region IN($region$)
        | dedup resource_type
        | sort resource_type
        </query>
      </search>
      <default>*</default>
      <delimiter>,</delimiter>
      <change>
        <eval token="form.resource_type">if(mvcount('form.resource_type')=0,"*",if(mvcount('form.resource_type')!=1,mvfilter('form.resource_type'!="*"),'form.resource_type'))</eval>
      </change>
    </input>
    <input type="multiselect" token="resource_name" searchWhenChanged="true" id="multiselect_input_action">
      <label>Resource Name</label>
      <fieldForLabel>resource_name</fieldForLabel>
      <fieldForValue>resource_name</fieldForValue>
      <choice value="*">All</choice>
      <search base="base">
        <query>
          | search accountid IN($accountid$)
          | search region IN($region$)
          | search resource_type IN($resource_type$)
          | fields resource_name
          | dedup resource_name
          | sort resource_name
        </query>
      </search>
      <default>*</default>
      <delimiter>,</delimiter>
      <change>
        <eval token="form.resource_name">if(mvcount('form.resource_name')=0,"*",if(mvcount('form.resource_name')!=1,mvfilter('form.resource_name'!="*"),'form.resource_name'))</eval>
      </change>
    </input>
    <input type="multiselect" token="resource_id" searchWhenChanged="true" id="multiselect_input_namespace">
      <label>Resource ID</label>
      <fieldForLabel>resource_id</fieldForLabel>
      <fieldForValue>resource_id</fieldForValue>
      <choice value="*">All</choice>
      <search base="base">
        <query>
          | search accountid IN($accountid$)
          | search region IN($region$)
          | search resource_type IN($resource_type$)
          | search resource_name IN($resource_name$)
          | dedup resource_id
          | sort resource_id</query>
      </search>
      <default>*</default>
      <delimiter>,</delimiter>
      <change>
        <eval token="form.resource_id">if(mvcount('form.resource_id')=0,"*",if(mvcount('form.resource_id')!=1,mvfilter('form.resource_id'!="*"),'form.resource_id'))</eval>
      </change>
    </input>
    <input type="multiselect" token="policy_name" searchWhenChanged="true">
      <label>Policy</label>
      <fieldForLabel>policy_name</fieldForLabel>
      <fieldForValue>policy_name</fieldForValue>
      <search base="base">
        <query>
          | search accountid IN($accountid$)
          | search region IN($region$)
          | search resource_type IN($resource_type$)
          | search resource_name IN($resource_name$)
          | search resource_id IN($resource_id$)
          | dedup policy_name | table policy_name
          </query>
      </search>
      <choice value="*">All</choice>
      <default>*</default>
      <delimiter>,</delimiter>
      <change>
        <eval token="form.policy_name">if(mvcount('form.policy_name')=0,"*",if(mvcount('form.policy_name')!=1,mvfilter('form.policy_name'!="*"),'form.policy_name'))</eval>
      </change>
    </input>
    <input type="dropdown" token="excluded_resource" searchWhenChanged="true">
      <label>Excluded Resources</label>
      <prefix>*</prefix>
      <suffix>*</suffix>
      <default>No</default>
      <fieldForLabel>excluded_resource</fieldForLabel>
      <fieldForValue>excluded_resource</fieldForValue>
      <search base="base">
        <query>| search accountid IN($accountid$)
          | search region IN($region$)
          | search resource_type IN($resource_type$)
          | search resource_name IN($resource_name$)
          | search resource_id IN($resource_id$)
          | search policy_name IN($policy_name$)
          | dedup excluded_resource | table excluded_resource</query>
      </search>
      <choice value="*">All</choice>
      <initialValue>No</initialValue>
    </input>
    <html>
       <style>
         div.fieldset.dashboard-form-globalfieldset div.dashboard-element.html.dashboard-element-html {
        display: inline-block;
           }
       </style>
       <a href="mms_unused_resources__consolidated_new" class="btn btn-primary">Reset</a>
     </html>
  </fieldset>
