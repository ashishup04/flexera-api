```xml
<form version="1.1">
  <label>Flexera Unused Resources - Consolidated</label>
  <search id="base">
    <query>
index=* "FlexeraUnusedResources-Corporate*" earliest=-24h
| rename account_id as accountid meta_policy_name as rule_name tags as resource_tags incident_state as compliance_status
| eval resource_id=if(isnull(resource_name) OR resource_name="", resource_id, resource_name)
| eval resource_type=rule_name
| eval capture_date=strftime(strptime(incident_created_at,"%Y-%m-%dT%H:%M:%SZ"),"%m-%d-%Y")
| eval timestamp=strftime(strptime(incident_updated_at,"%Y-%m-%dT%H:%M:%SZ"),"%m-%d-%Y %H:%M:%S")
| eval status=compliance_status
| eval resource_created_date=if(isnotnull(launchTime), strftime(strptime(launchTime,"%Y-%m-%dT%H:%M:%S.%3NZ"),"%m-%d-%Y"), strftime(now()-tonumber(age)*86400,"%m-%d-%Y"))
| eval resource_details=trim(if(isnotnull(codeSize),"codeSize=".codeSize." ","").if(isnotnull(memorySize),"memorySize=".memorySize." ","").if(isnotnull(runtime),"runtime=".runtime." ","").if(isnotnull(invocations),"invocations=".invocations." ","").if(isnotnull(size),"size=".size." ","").if(isnotnull(iops),"iops=".iops,""))
| eval action_result="Success", action_type="Capture", auto_remediation="Captured", remediated_date="N/A", resource_created_by="N/A", resource_status="Available", retention_date="Not Available"
| lookup all_aws_accounts.csv accountid OUTPUT accountalias
| eval accountalias=coalesce(accountalias, account_name)
| fillnull value="null"
| fillnull value="null" excluded_resource updated_by updated_date exclusion_updated_by exclusion_updated_date
| dedup accountid region resource_id
| rename retention_date as schedule
| eval remediation=if(auto_remediation="ON","AutoRemediation","ManualRemediation")
| eval countdown = if(remediation="ManualRemediation",0, round((strptime(schedule, "%m-%d-%Y") - now())/60/60/24, 0))
| eval remediation_schedule_date = if(remediation="ManualRemediation","NA",schedule)
| eval remediated="No"
| eval resource_name=if(resource_name="null","default",resource_name)
| eval accountid=case(len(accountid)=10,"00".accountid,len(accountid)=11,"0".accountid,1=1,accountid)
| table accountid accountalias region resource_type resource_id resource_name action_type action_result excluded_resource capture_date remediation_schedule_date remediation auto_remediation countdown rule_name remediated remediated_date updated_by updated_date resource_created_date resource_created_by resource_status resource_details resource_tags compliance_status status timestamp exclusion_updated_by exclusion_updated_date
| eval flag=case(remediated="No" and action_type="Capture","No", remediated="Yes" and action_type !="Capture","Yes",1=1,"null")
